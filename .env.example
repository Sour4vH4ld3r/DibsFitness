# Application Settings
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://projects.orbitdynamix.in/DibsFitness
NEXT_PUBLIC_BASE_PATH=/DibsFitness
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dibsfitness
DB_USER=dibsfitness_user
DB_PASSWORD=your_secure_password_here

# Redis Configuration (for caching/sessions)
REDIS_URL=redis://default:password@localhost:6379
REDIS_PASSWORD=your_redis_password_here

# Authentication
NEXTAUTH_SECRET=your-nextauth-secret-key-generate-with-openssl
NEXTAUTH_URL=https://projects.orbitdynamix.in/DibsFitness

# JWT Secret (if using JWT)
JWT_SECRET=your-jwt-secret-key

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=DibsFitness <noreply@dibsfitness.com>

# AWS S3 (for file uploads - optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=dibsfitness-uploads

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth (optional)
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# Monitoring & Analytics
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# API Keys
OPENAI_API_KEY=sk-your-openai-api-key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Feature Flags
ENABLE_PAYMENT=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_EMAIL_VERIFICATION=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Security
SESSION_SECRET=your-session-secret-key
CSRF_SECRET=your-csrf-secret-key

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We're currently performing maintenance. We'll be back soon!"